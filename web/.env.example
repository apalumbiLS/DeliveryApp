# Copy to .env.local and fill in. See docs/architecture/11-deployment-and-environments.md#configuration
# .env.local is gitignored; this file is the committed contract.

# Supabase
# Dashboard → Project Settings → API Keys → "Publishable and secret API keys".
# The publishable and secret keys replace the legacy anon / service_role JWTs,
# which Supabase deprecates at the end of 2026. Both are opaque strings, not
# JWTs — nothing needs to decode them.
NEXT_PUBLIC_SUPABASE_URL=               # https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=   # sb_publishable_...  browser-safe; RLS applies
SUPABASE_SECRET_KEY=                    # sb_secret_...  server-only, never NEXT_PUBLIC_; bypasses RLS

# Mailgun
# The account is temporary until the client's is set up. Swapping it should be
# an environment change only — see
# docs/architecture/11-deployment-and-environments.md#swapping-the-mailgun-account
MAILGUN_API_KEY=                    # outbound sending + the Messages API
MAILGUN_SIGNING_KEY=                # inbound webhook verification (HMAC)
MAILGUN_DOMAIN=                     # outbound sending domain
ORDER_ALIAS_DOMAIN=                 # the domain customers send carts to. This is
                                    # also the inbound domain — one value, since
                                    # a Mailgun route only fires for a domain
                                    # whose MX records point at Mailgun.

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Cron sweeps
CRON_SECRET=                        # shared secret for /api/cron/* requests

# LLM fallback
LLM_API_KEY=
LLM_MODEL=

# App
APP_URL=
APP_ENV=local|preview|production
